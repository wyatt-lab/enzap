const cna_colors = [RGB(0,0,255), RGB(120,120,255), RGB(0,0,0), RGB(255,120,120), RGB(255,0,0)]

function cn_color(lr)
	#maf = cn.median_af[g, s]
	#if lr <= -0.15 && maf >= 0.6; return -1; end
	call = 0
	if lr <= -0.3; call = -1; end
	if lr <= -1.0; call = -2; end
	#if lr >= 0.15 && maf >= 0.6; return 1; end
	if lr >= 0.3; call = 1; end
	if lr >= 0.7; call = 2; end
	return cna_colors[call + 3]
end

